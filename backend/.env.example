# TDX 運輸資料流通服務金鑰
# 取得方式：登入 https://tdx.transportdata.tw → 會員專區 › 資料服務 › 服務金鑰
# 注意：請用 cp 複製這個檔案（cp .env.example .env），不要 rename，範本要留著繳交。
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=

# 查詢的縣市。公車 API 可接受的值：Taipei, NewTaipei, Taoyuan, Taichung, Tainan,
# Kaohsiung, Keelung, Hsinchu, HsinchuCounty, MiaoliCounty, ChanghuaCounty,
# NantouCounty, YunlinCounty, ChiayiCounty, Chiayi, PingtungCounty, YilanCounty,
# HualienCounty, TaitungCounty, PenghuCounty, KinmenCounty
TDX_CITY=Taipei

# 服務埠號。Cloud Run 會自動提供，本機開發不設就用 8080。
PORT=8080

# 允許的前端來源，用逗號分隔；開發時可用 *
ALLOWED_ORIGINS=*

# 快取秒數（即時資料／靜態資料）。
# TDX 限制是每個來源 IP 每秒 50 次，TTL_REALTIME 不要調到 5 秒以下。
TTL_REALTIME=15
TTL_STATIC=43200

# 判定「已上車」的距離（公尺）
BOARD_RADIUS_M=60
# 別條路線的車要比目標車近這麼多（公尺）才會警告搭錯車
WRONG_BUS_MARGIN_M=30
